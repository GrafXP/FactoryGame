# Apache config for deploying dist/ at a domain root.

# Client-side routes (/play, /help) have no file on disk; serve the app instead of a 404.
FallbackResource /index.html

AddType application/manifest+json .webmanifest

# Built assets have content hashes in their names, so they never change; index.html must always be revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
